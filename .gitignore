# .gitignore
# Build artifacts
# 生成文件全部落在 build/ 下（对象、静态库、依赖文件、可执行文件、PTX、
# GPU 引擎），目录结构镜像源码树，所以这一条就够了。
*.o
*.a
/build/
/msieve
/gnfs-lasieve4e
/gnfs-lasieve4e.exe
/yafu_test
/yafu_test_full
/yafu_test_sanitize
/yafu_test_sanitize.exe
*.no
*.qo

# 产物改到 build/ 之前的落点，留着当过渡护栏：这两处已经不再产生东西，
# 真出现在 git status 里说明还有构建没走新的 Makefile。跑一次 make clean
# 之后下面几条就可以删掉。
/yafu
.deps/

# Logs / Checkpoints / data files
*.log
factor.json
siqs.dat
cadoWorkdir
/*.db
nfs.*
*.optrpt
*.obj
*.tlog
*.last_spq*
msieve.dat

# 下面这些是产物改到 build/ 之前的落点。留着当过渡期的护栏：这些地方已经
# 不再产生任何东西，出现在 git status 里就说明有构建没走新的 Makefile。
factor/nfs/lasieve/ecmtest
factor/nfs/lasieve/mpqs3test
factor/nfs/lasieve/mpqstest
factor/nfs/lasieve/mpqsstat
factor/nfs/lasieve/mpqst
factor/nfs/lasieve/tmpqs

# lasieve 构建与测试的旧产物
factor/nfs/lasieve/gnfs-lasieve4I*e
factor/nfs/lasieve/*.job
factor/nfs/lasieve/snfs_*.txt
factor/nfs/lasieve/*.o
factor/nfs/lasieve/*.a
# 合成单一二进制后按 I 各编一份的中间产物
factor/nfs/lasieve/objI*/
factor/nfs/lasieve/kernels/coreI*/
factor/nfs/lasieve/kernels/*I1[1-6].o
factor/nfs/lasieve/kernels/libcoreI*.a
factor/nfs/lasieve/kernels/liblasieveI*.a

# 筛法器的 stat/test 目标：make 生成的开发用可执行文件
factor/nfs/lasieve/ctx_test
factor/nfs/lasieve/ecm_pm1_test
factor/nfs/lasieve/pm1test
factor/nfs/lasieve/pm1stat
factor/nfs/lasieve/ecmstat
